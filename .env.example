# Phase 1 (rep lookup) needs NO keys. All Phase 1 data sources are free and keyless.

# Phase 2: plain-English bill summaries
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Phase 2: bill data
OPEN_STATES_API_KEY=
CONGRESS_GOV_API_KEY=

# Polling places and early voting on the ballot page (free key: Google Cloud console,
# enable "Google Civic Information API"). Without it, the page links to VoterView.
GOOGLE_CIVIC_API_KEY=
